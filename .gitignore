# Build output
dist/

# Dependencies
node_modules/

# Regenerable intermediates — keyed by (pdf content hash + engine_version + ir_version).
# C2: the PDF content hash is used locally only; it is never written to a tracked path.
.cache/
# The engine's default IR/OCR cache (kept on disk, not in a RAM-backed /tmp).
.tmp/

# Test / coverage artifacts
coverage/
.vitest/

# Web build output and the OCR runtime staged into it (copied from node_modules).
dist-web/
web/public/vendor/

# Playwright artifacts
test-results/
playwright-report/

# OS / editor
.DS_Store
*~
