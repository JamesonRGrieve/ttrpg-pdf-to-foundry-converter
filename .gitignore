# Build output
dist/

# Dependencies
node_modules/

# Regenerable intermediates — keyed by (pdf content hash + engine_version + ir_version).
# C2: the PDF content hash is used locally only; it is never written to a tracked path.
.cache/
# The engine's default IR/OCR cache (kept on disk, not in a RAM-backed /tmp).
.tmp/

# Test / coverage artifacts
coverage/
.vitest/

# Web build output and the OCR runtime staged into it (copied from node_modules).
dist-web/
dist-foundry/
dist-foundry-release/
# A local Foundry v14 release (or a symlink to one) for the Foundry e2e suite, and its test worlds; never committed.
.foundry-release
.foundry-test-data-*/
web/public/vendor/

# Corpus-audit tooling and its results. These drive the engine against a private
# commercial corpus and name the books they audit, so they stay local and are never
# published (the shippable engine, fixtures and gates do not depend on them).
output/
PROGRESS.md
scripts/*.json
scripts/audit-*
scripts/validate-dh2-*
scripts/crop-*
scripts/im-*
scripts/owbc-*
scripts/__pycache__/
.claude/

# Playwright artifacts
test-results/
playwright-report/

# OS / editor
.DS_Store
*~
