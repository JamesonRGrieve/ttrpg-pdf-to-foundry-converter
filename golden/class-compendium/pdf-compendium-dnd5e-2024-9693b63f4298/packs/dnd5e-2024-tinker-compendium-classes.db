{"_id":"NJmz9lFpaoXzZed4","_stats":{"createdTime":0,"modifiedTime":0},"effects":[],"flags":{},"name":"Tinker","sort":500000,"system":{"advancement":[{"_id":"8Q5VfcWEYCsrywD4","configuration":{},"title":"","type":"HitPoints","value":{}},{"_id":"mnAxQ4l5qx6U7tub","classRestriction":"primary","configuration":{"allowReplacements":false,"choices":[],"grants":["saves:dex","saves:int"],"mode":"default"},"level":1,"title":"Saving Throw Proficiencies","type":"Trait","value":{}},{"_id":"qgnr95CeD5UpAD9d","classRestriction":"primary","configuration":{"allowReplacements":false,"choices":[],"grants":["armor:lgt"],"mode":"default"},"level":1,"title":"Armor Proficiencies","type":"Trait","value":{}},{"_id":"ORuDW26R0Ji2oveS","classRestriction":"primary","configuration":{"allowReplacements":false,"choices":[],"grants":["weapon:sim"],"mode":"default"},"level":1,"title":"Weapon Proficiencies","type":"Trait","value":{}},{"_id":"6FKs5efMTY69PWJ8","classRestriction":"primary","configuration":{"allowReplacements":false,"choices":[{"count":2,"pool":["skills:arc","skills:his","skills:inv","skills:prc"]}],"grants":[],"mode":"default"},"level":1,"title":"Skill Proficiencies","type":"Trait","value":{}},{"_id":"g9hvNSMrbXPH04hZ","configuration":{"items":[{"optional":false,"uuid":"Compendium.pdf-compendium-dnd5e-2024-9693b63f4298.dnd5e-2024-tinker-compendium-class-features.Item.3YsyfM3dEXoPwxOD"}],"optional":false,"spell":null},"level":1,"title":"Features","type":"ItemGrant","value":{}},{"_id":"0ezeGQXskLWpGbcT","configuration":{"items":[{"optional":false,"uuid":"Compendium.pdf-compendium-dnd5e-2024-9693b63f4298.dnd5e-2024-tinker-compendium-class-features.Item.fdTTrPkk0ANqR3SE"}],"optional":false,"spell":null},"level":2,"title":"Features","type":"ItemGrant","value":{}},{"_id":"OIjTC8jR0yiKeKZv","configuration":{"items":[{"optional":false,"uuid":"Compendium.pdf-compendium-dnd5e-2024-9693b63f4298.dnd5e-2024-tinker-compendium-class-features.Item.xGvfmkeYs3jDsHOM"}],"optional":false,"spell":null},"level":5,"title":"Features","type":"ItemGrant","value":{}},{"_id":"pTSt6VwFRuKQ1J3D","configuration":{"cap":2,"fixed":{"cha":0,"con":0,"dex":0,"int":0,"str":0,"wis":0},"locked":[],"points":2},"level":4,"title":"","type":"AbilityScoreImprovement","value":{}},{"_id":"eEDVLfFlaQ8PxMgk","configuration":{"distance":{"units":""},"identifier":"charges","scale":{"1":{"value":2},"3":{"value":3},"5":{"value":4}},"type":"number"},"title":"Charges","type":"ScaleValue","value":{}},{"_id":"dvyTYhOVxkGkxjGb","configuration":{"distance":{"units":""},"identifier":"dice","scale":{"1":{"faces":4,"number":1},"3":{"faces":6,"number":1},"5":{"faces":8,"number":1}},"type":"dice"},"title":"Dice","type":"ScaleValue","value":{}},{"_id":"3CDM7qkGSlrnXTCo","configuration":{},"level":3,"title":"","type":"Subclass","value":{}}],"description":{"chat":"","value":"<p>Tinkers mend clocks, springs and small engines, and carry a satchel of odd parts wherever they wander.</p><h3>Core Tinker Traits</h3><table><tr><td>Primary Ability</td><td>Intelligence</td></tr><tr><td>Hit Point Die</td><td>D8 per Tinker level</td></tr><tr><td>Saving Throws</td><td>Intelligence and Dexterity</td></tr><tr><td>Skill Proficiencies</td><td>Choose 2: Arcana, History, Investigation, or Perception</td></tr><tr><td>Weapon Proficiencies</td><td>Simple weapons</td></tr><tr><td>Armor Training</td><td>Light armor</td></tr><tr><td>Starting Equipment</td><td>Tool Satchel and 9 GP, or 40 GP</td></tr></table><h3>Becoming a Tinker</h3><ul><li>Gain the traits in the Core Tinker Traits table.</li><li>Gain the Tinker’s level 1 features.</li></ul><h3>Tinker Class Features</h3><p>As a Tinker, you gain these features at the Tinker levels shown in the Tinker Features table.</p><h4>Level 3: Tinker Subclass</h4><p>You choose a Tinker subclass, such as the Clockwork Path.</p><h4>Level 4: Ability Score Improvement</h4><p>You gain the Ability Score Improvement feat or another feat of your choice.</p><table><tr><th>Level</th><th>Proficiency Bonus</th><th>Class Features</th><th>Charges</th><th>Dice</th></tr><tr><td>1</td><td>+2</td><td>Spark</td><td>2</td><td>1d4</td></tr><tr><td>2</td><td>+2</td><td>Gadget</td><td>2</td><td>1d4</td></tr><tr><td>3</td><td>+2</td><td>Tinker Subclass</td><td>3</td><td>1d6</td></tr><tr><td>4</td><td>+2</td><td>Ability Score Improvement</td><td>3</td><td>1d6</td></tr><tr><td>5</td><td>+3</td><td>Overclock</td><td>4</td><td>1d8</td></tr></table>"},"hd":{"additional":"","denomination":"d8","spent":0},"identifier":"tinker","levels":1,"primaryAbility":{"all":true,"value":["int"]},"source":{"book":"Tinker Compendium","custom":"","license":"","page":"1","rules":"2024"}},"type":"class"}
