{"_id":"CfzlkiX3AyuDcgbt","_stats":{"createdTime":0,"modifiedTime":0},"effects":[],"flags":{},"name":"Lantern Sense","sort":1400000,"system":{"aptitudes":["Perception","Fieldcraft"],"benefit":"<p>Long nights on the road have taught the wayfarer to read shapes at the edge of the lamp’s reach. He suffers no penalty to Awareness tests in dim light.</p>","description":{"dh2":{"chat":"","summary":"","value":"<p>Long nights on the road have taught the wayfarer to read shapes at the edge of the lamp’s reach. He suffers no penalty to Awareness tests in dim light.</p>"}},"gameSystems":["dh2"],"prerequisites":{"text":"Perception 35"},"source":{"dh2":{"book":"wayfarers-field-manual","page":"2","provenance":"raw"}},"tier":2},"type":"talent"}
