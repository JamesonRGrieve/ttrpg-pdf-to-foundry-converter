{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "declaration": false,
        "types": ["node", "vitest/globals"]
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "scripts/**/*.ts",
        "e2e/**/*.ts",
        "e2e-foundry/**/*.ts",
        "playwright.config.ts",
        "playwright.foundry.config.ts"
    ],
    "exclude": ["node_modules", "dist", ".cache"]
}
