{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/JamesonRGrieve/foundry-pdf-parser/profile.schema.json",
    "title": "foundry-pdf-parser profile",
    "description": "A document-specific parsing profile. Data, not code (spec §8.1): validated at load, then interpreted. Never eval'd; no filesystem or network access.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "profile_id", "name", "version", "selectors", "blocks", "emit"],
    "properties": {
        "schema_version": { "type": "integer", "minimum": 1 },
        "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "license": { "type": "string" },
        "fingerprint": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "page_size": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["w", "h", "tol"],
                    "properties": {
                        "w": { "type": "number" },
                        "h": { "type": "number" },
                        "tol": { "type": "number", "minimum": 0 }
                    }
                },
                "columns": { "type": "integer", "minimum": 1 },
                "fonts": { "type": "array", "items": { "type": "string" } },
                "size_buckets": { "type": "array", "items": { "type": "number" } }
            }
        },
        "exclude": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["region"],
                "properties": {
                    "region": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["y_min", "y_max"],
                        "properties": {
                            "y_min": { "type": "number" },
                            "y_max": { "type": "number" },
                            "x_min": { "type": "number" },
                            "x_max": { "type": "number" }
                        }
                    }
                }
            }
        },
        "selectors": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "weight": { "enum": ["normal", "bold"] },
                    "size": { "type": "number" },
                    "italic": { "type": "boolean" },
                    "font": { "type": "string" },
                    "column": { "type": "integer", "minimum": 0 },
                    "indent": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["min", "max"],
                        "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
                    }
                }
            }
        },
        "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "starts_at", "ends_at", "fields"],
                "properties": {
                    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
                    "starts_at": { "type": "string" },
                    "ends_at": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "next": { "type": "string" },
                            "selector": { "type": "string" }
                        },
                        "oneOf": [{ "required": ["next"] }, { "required": ["selector"] }]
                    },
                    "fields": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["name", "from"],
                            "properties": {
                                "name": { "type": "string", "minLength": 1 },
                                "from": { "type": "string" },
                                "match": { "type": "string" },
                                "capture": { "type": "integer", "minimum": 0 },
                                "required": { "type": "boolean" },
                                "transform": { "type": "array", "items": { "type": "string" } }
                            }
                        }
                    },
                    "images": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["id", "where", "pick"],
                            "properties": {
                                "id": { "type": "string", "minLength": 1 },
                                "pick": { "enum": ["largest", "first_by_sort", "all"] },
                                "where": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "within_block": { "type": "boolean" },
                                        "max_area_pt2": { "type": "number", "minimum": 0 },
                                        "aspect": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": ["min", "max"],
                                            "properties": {
                                                "min": { "type": "number" },
                                                "max": { "type": "number" }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "emit": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["block", "document_type", "pack", "map"],
                "properties": {
                    "block": { "type": "string" },
                    "document_type": { "enum": ["Item", "Actor", "JournalEntry", "RollTable", "Scene"] },
                    "pack": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
                    "group": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
                    "map": { "type": "object", "additionalProperties": { "type": "string" } },
                    "enrichment": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["from", "key"],
                            "properties": {
                                "from": { "const": "wiki" },
                                "key": { "type": "string" }
                            }
                        }
                    }
                }
            }
        }
    }
}
