{
    "name": "foundry-pdf-parser",
    "version": "0.1.0",
    "description": "Deterministic PDF to Foundry VTT compendium engine. Infers structure from the PDF alone (text layer + embedded OCR); runs in Node or entirely in the browser; ships zero third-party data.",
    "license": "AGPL-3.0-or-later",
    "type": "module",
    "packageManager": "pnpm@11.1.1",
    "engines": {
        "node": ">=22.13"
    },
    "bin": {
        "foundry-pdf-parser": "dist/node/cli.js"
    },
    "exports": {
        ".": "./dist/index.js"
    },
    "files": [
        "dist",
        "docs",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/copy-build-assets.mjs",
        "clean": "rm -rf dist .cache",
        "cli": "tsx src/node/cli.ts",
        "web:assets": "node scripts/copy-web-assets.mjs",
        "web:dev": "pnpm web:assets && vite",
        "web:build": "pnpm web:assets && vite build",
        "web:typecheck": "tsc -p tsconfig.web.json",
        "test:e2e": "playwright test",
        "fixtures:render": "node scripts/render-fixtures.mjs",
        "golden:update": "tsx scripts/update-golden.ts",
        "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
        "lint": "eslint . && biome lint .",
        "lint:fix": "eslint . --fix && biome lint --write .",
        "lint:biome": "biome lint .",
        "lint:ratchet": "node scripts/lint-ratchet.mjs",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "gate:determinism": "node scripts/gate-determinism.mjs",
        "gate:timestamps": "node scripts/gate-timestamp-scan.mjs",
        "gate:titles": "node scripts/gate-title-scan.mjs",
        "gate:deps": "node scripts/gate-dep-pin.mjs",
        "gate:all": "node scripts/gate-all.mjs",
        "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format && pnpm test && pnpm gate:all",
        "prepare": "husky || true"
    },
    "dependencies": {
        "@gutenye/ocr-models": "1.4.2",
        "@noble/hashes": "2.4.0",
        "@tesseract.js-data/eng": "1.0.0",
        "fflate": "0.8.3",
        "mupdf": "1.28.1",
        "onnxruntime-web": "1.30.0",
        "pdf-lib": "1.17.1",
        "pdfjs-dist": "4.10.38",
        "tesseract.js": "7.0.0",
        "tesseract.js-core": "7.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@playwright/test": "1.63.0",
        "@types/node": "^22.10.5",
        "@typescript-eslint/eslint-plugin": "^8.19.0",
        "@typescript-eslint/parser": "^8.19.0",
        "@vitest/coverage-v8": "^2.1.8",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-promise": "^7.2.1",
        "husky": "^9.1.7",
        "prettier": "^3.4.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vite": "8.3.1",
        "vitest": "^2.1.8"
    }
}
